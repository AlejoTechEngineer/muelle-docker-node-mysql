# Configuración propia del servidor MySQL de Muelle
[mysqld]
character-set-server  = utf8mb4
collation-server      = utf8mb4_0900_ai_ci
# Hora de Colombia (UTC-5) para TIMESTAMP y NOW()
default-time-zone     = '-05:00'
# Modo estricto: rechaza datos inválidos en lugar de truncarlos en silencio
sql_mode              = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
# Ajustes modestos para un entorno de laboratorio (contenedor limitado a 1 GB)
innodb_buffer_pool_size = 256M
max_connections         = 60
skip-name-resolve

[client]
default-character-set = utf8mb4
